# Shared secret used by all three deployments.
DIAGNOSTIC_API_KEY=replace-with-one-shared-random-secret

# Deployment role: diagnostic, exchange, hospital, or all.
APP_ROLE=all

# Diagnostic deployment only.
EXCHANGE_BASE_URL=https://your-exchange.vercel.app

# Exchange deployment only.
HOSPITAL_BASE_URL=https://your-hospital.vercel.app

# Exchange and Hospital deployments.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require